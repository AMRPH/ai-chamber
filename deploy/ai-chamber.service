[Unit]
Description=AI Chamber with live activation steering
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ai-chamber
Group=ai-chamber
WorkingDirectory=/opt/ai-chamber
EnvironmentFile=/opt/ai-chamber/.env
Environment=PYTHONUNBUFFERED=1
Environment=VLLM_USE_V2_MODEL_RUNNER=0
ExecStart=/opt/ai-chamber/.venv/bin/python -m uvicorn chat:app --host 127.0.0.1 --port 18765 --no-access-log
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
