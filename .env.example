# Linux / NVIDIA CUDA. For a Mac, use mps and qwen3-4b.
CHAMBER_DEVICE=cuda:0
CHAMBER_MODEL=qwen3-14b
CHAMBER_PARALLEL=8
CHAMBER_GPU_MEMORY=0.95
CHAMBER_CONTEXT=4096

# Optional: SHA-256 digest of your own model-switch password.
# Empty means model switching is disabled; the default model still loads.
CHAMBER_MODEL_PASSWORD_SHA256=

# Optional cache, authentication, and compiler settings for your machine.
# HF_HOME=/path/to/model-cache
# HF_TOKEN=
# CUDA_HOME=/usr/local/cuda
# CC=/usr/bin/gcc
# CXX=/usr/bin/g++
# NVCC_CCBIN=/usr/bin/gcc
